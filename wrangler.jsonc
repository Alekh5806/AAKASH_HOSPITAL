{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aakash-eye-hospital",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    // Every page is prerendered, so an unknown path is a real 404 (dist/404.html)
    // rather than the app shell with a 200.
    "not_found_handling": "404-page",
    // /services is the page; /services/ and /services.html redirect to it.
    "html_handling": "drop-trailing-slash"
  }
}
